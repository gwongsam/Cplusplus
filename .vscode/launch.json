{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (lldb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/exe",
            "args": [], // any command line arguments for your program
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "lldb",
            "targetArchitecture": "arm64",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "", // e.g., name of the build task to run before debugging
            "logging": {
                "trace": false,
                "traceResponse": false,
                "engineLogging": false
            },
            "osx": {
                "MIMode": "lldb"
            }
        }
    ]
}